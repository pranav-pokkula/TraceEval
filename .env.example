# Fixture mode works with no environment file and no external services.
TRACEEVAL_STORAGE=local
# Set both public values and TRACEEVAL_STORAGE=supabase for authenticated storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only live adapter. Never use NEXT_PUBLIC_ for these.
TRACEEVAL_LIVE_ENABLED=false
MODEL_API_URL=https://api.openai.com/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=
MODEL_ALLOWED_HOSTS=api.openai.com
# Live requests require Supabase storage/authentication, at most 10 cases per run.
# Optional local database test only; never expose to the browser.
TRACEEVAL_TEST_DATABASE_URL=
